@page
@model CompanyEmployees.IDP.Pages.Account.ForgotPassword.IndexModel
@{
}
<h2>Forgot Password</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div class="form-group">
                <label asp-for="forgotPassword.Email" class="control-label"></label>
                <input asp-for="forgotPassword.Email" class="form-control" />
                <span asp-validation-for="forgotPassword.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Submit" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
